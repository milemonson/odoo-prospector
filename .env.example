# Copiar este archivo como .env y completar los valores

# --- EMAIL (tu cuenta geconsas.com — hosting DonWeb/Ferozo) ---
EMAIL_ADDRESS=adminstracion@geconsas.com
EMAIL_PASSWORD=TU_CONTRASEÑA_AQUI

# Opción A — servidor del dominio (más común en DonWeb):
SMTP_SERVER=mail.geconsas.com
SMTP_PORT=465                        # 465 con SSL/TLS  ← recomendado DonWeb
# SMTP_PORT=587                      # alternativa con STARTTLS

# Opción B — servidor Ferozo directo (ver en panel DonWeb > Correos > Datos de configuración):
# SMTP_SERVER=TU_USUARIO.ferozo.com  # ej: abc123.ferozo.com
# SMTP_PORT=465

SENDER_NAME=Gecons

# --- LIMITES (evitar spam/bloqueos) ---
EMAILS_PER_DAY=30
DELAY_BETWEEN_EMAILS=90              # segundos entre cada email

# --- HUNTER.IO (opcional, 25 búsquedas gratis/mes) ---
# Registrate en hunter.io para obtener tu API key
HUNTER_API_KEY=

# --- ADZUNA (opcional, 500 búsquedas gratis/mes — muy recomendado) ---
# Registro gratuito en: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- BÚSQUEDA ---
SEARCH_HOURS_OLD=72                  # trabajos publicados en las últimas N horas
RESULTS_PER_SOURCE=50
